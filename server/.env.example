PORT=3000
DATABASE_URL=postgres://gym_tracker:gym_tracker@localhost:5432/gym_tracker
NODE_ENV=development
DEV_AUTH_USER_ID=local-development-user
# Comma-separated browser origins. Leave empty for development; mobile
# requests normally do not send an Origin header.
CORS_ORIGINS=
# The Web OAuth client ID used as the audience of Google ID tokens.
GOOGLE_CLIENT_ID=
